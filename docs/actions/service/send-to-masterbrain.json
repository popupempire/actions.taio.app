{
  "actions" : [
    {
      "type" : "@comment",
      "parameters" : {
        "text" : {
          "value" : "Send text to Master-brain knowledge management system. Please configure your API URL below."
        }
      }
    },
    {
      "type" : "@ui.text-input",
      "parameters" : {
        "prompt" : {
          "value" : "Enter Master-brain API URL"
        },
        "keyboardType" : 5,
        "initialText" : {
          "value" : ""
        },
        "singleLineText" : true
      }
    },
    {
      "type" : "@flow.set-variable",
      "parameters" : {
        "value" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        },
        "name" : {
          "value" : "apiUrl"
        }
      }
    },
    {
      "type" : "@ui.text-input",
      "parameters" : {
        "prompt" : {
          "value" : "Enter tags (optional, space-separated)"
        },
        "keyboardType" : 0,
        "initialText" : {
          "value" : "#Taio #knowledge"
        },
        "singleLineText" : true
      }
    },
    {
      "type" : "@flow.set-variable",
      "parameters" : {
        "value" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        },
        "name" : {
          "value" : "tags"
        }
      }
    },
    {
      "type" : "@flow.if",
      "parameters" : {
        "blockIdentifier" : "MASTERBRAIN-API-CHECK",
        "condition" : 0,
        "rhs" : {
          "value" : ""
        },
        "lhs" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "apiUrl"
            }
          ]
        }
      }
    },
    {
      "type" : "@ui.alert",
      "parameters" : {
        "title" : {
          "value" : "Error"
        },
        "message" : {
          "value" : "Please configure your Master-brain API URL first."
        }
      }
    },
    {
      "type" : "@flow.stop"
    },
    {
      "type" : "@flow.endif",
      "parameters" : {
        "blockIdentifier" : "MASTERBRAIN-API-CHECK"
      }
    },
    {
      "type" : "@util.get-clipboard",
      "parameters" : {
        "mode" : 0
      }
    },
    {
      "type" : "@flow.set-variable",
      "parameters" : {
        "value" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        },
        "name" : {
          "value" : "content"
        }
      }
    },
    {
      "type" : "@flow.javascript",
      "parameters" : {
        "script" : {
          "value" : "const apiUrl = $actions.getVariable('apiUrl');\nconst content = $actions.getVariable('content');\nconst tags = $actions.getVariable('tags');\n\nconst payload = {\n  content: content,\n  tags: tags,\n  source: 'Taio',\n  timestamp: new Date().toISOString()\n};\n\nconst response = await $http.post({\n  url: apiUrl,\n  header: {\n    'Content-Type': 'application/json'\n  },\n  body: payload\n});\n\nif (response.error) {\n  $actions.resolve({\n    success: false,\n    message: 'Failed to send to Master-brain: ' + response.error\n  });\n} else {\n  $actions.resolve({\n    success: true,\n    message: 'Successfully sent to Master-brain'\n  });\n}"
        }
      }
    },
    {
      "type" : "@flow.set-variable",
      "parameters" : {
        "value" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        },
        "name" : {
          "value" : "result"
        }
      }
    },
    {
      "type" : "@flow.javascript",
      "parameters" : {
        "script" : {
          "value" : "const result = $actions.getVariable('result');\nif (result.success) {\n  $actions.resolve(result.message);\n} else {\n  throw new Error(result.message);\n}"
        }
      }
    },
    {
      "type" : "@ui.toast",
      "parameters" : {
        "style" : 0,
        "waitUntilDone" : false,
        "title" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        }
      }
    }
  ],
  "buildVersion" : 1,
  "name" : "Send to Master-brain",
  "clientMinVersion" : 624,
  "summary" : "Send clipboard content to Master-brain knowledge management system",
  "icon" : {
    "glyph" : "brain.head.profile",
    "color" : "#7B68EE"
  },
  "clientVersion" : 685
}

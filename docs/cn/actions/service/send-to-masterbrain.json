{
  "actions" : [
    {
      "type" : "@comment",
      "parameters" : {
        "text" : {
          "value" : "发送文本到 Master-brain 知识管理系统。请在下方配置您的 API 地址。"
        }
      }
    },
    {
      "type" : "@ui.text-input",
      "parameters" : {
        "prompt" : {
          "value" : "请输入 Master-brain API 地址"
        },
        "keyboardType" : 5,
        "initialText" : {
          "value" : ""
        },
        "singleLineText" : true
      }
    },
    {
      "type" : "@flow.set-variable",
      "parameters" : {
        "value" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        },
        "name" : {
          "value" : "apiUrl"
        }
      }
    },
    {
      "type" : "@ui.text-input",
      "parameters" : {
        "prompt" : {
          "value" : "请输入标签（可选，空格分隔）"
        },
        "keyboardType" : 0,
        "initialText" : {
          "value" : "#Taio #知识"
        },
        "singleLineText" : true
      }
    },
    {
      "type" : "@flow.set-variable",
      "parameters" : {
        "value" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        },
        "name" : {
          "value" : "tags"
        }
      }
    },
    {
      "type" : "@flow.if",
      "parameters" : {
        "blockIdentifier" : "MASTERBRAIN-API-CHECK",
        "condition" : 0,
        "rhs" : {
          "value" : ""
        },
        "lhs" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "apiUrl"
            }
          ]
        }
      }
    },
    {
      "type" : "@ui.alert",
      "parameters" : {
        "title" : {
          "value" : "错误"
        },
        "message" : {
          "value" : "请先配置您的 Master-brain API 地址。"
        }
      }
    },
    {
      "type" : "@flow.stop"
    },
    {
      "type" : "@flow.endif",
      "parameters" : {
        "blockIdentifier" : "MASTERBRAIN-API-CHECK"
      }
    },
    {
      "type" : "@util.get-clipboard",
      "parameters" : {
        "mode" : 0
      }
    },
    {
      "type" : "@flow.set-variable",
      "parameters" : {
        "value" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        },
        "name" : {
          "value" : "content"
        }
      }
    },
    {
      "type" : "@flow.javascript",
      "parameters" : {
        "script" : {
          "value" : "const apiUrl = $actions.getVariable('apiUrl');\nconst content = $actions.getVariable('content');\nconst tags = $actions.getVariable('tags');\n\nconst payload = {\n  content: content,\n  tags: tags,\n  source: 'Taio',\n  timestamp: new Date().toISOString()\n};\n\nconst response = await $http.post({\n  url: apiUrl,\n  header: {\n    'Content-Type': 'application/json'\n  },\n  body: payload\n});\n\nif (response.error) {\n  $actions.resolve({\n    success: false,\n    message: '发送到 Master-brain 失败：' + response.error\n  });\n} else {\n  $actions.resolve({\n    success: true,\n    message: '成功发送到 Master-brain'\n  });\n}"
        }
      }
    },
    {
      "type" : "@flow.set-variable",
      "parameters" : {
        "value" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        },
        "name" : {
          "value" : "result"
        }
      }
    },
    {
      "type" : "@flow.javascript",
      "parameters" : {
        "script" : {
          "value" : "const result = $actions.getVariable('result');\nif (result.success) {\n  $actions.resolve(result.message);\n} else {\n  throw new Error(result.message);\n}"
        }
      }
    },
    {
      "type" : "@ui.toast",
      "parameters" : {
        "style" : 0,
        "waitUntilDone" : false,
        "title" : {
          "value" : "$",
          "tokens" : [
            {
              "location" : 0,
              "value" : "@input"
            }
          ]
        }
      }
    }
  ],
  "buildVersion" : 1,
  "name" : "发送到 Master-brain",
  "clientMinVersion" : 624,
  "summary" : "将剪贴板内容发送到 Master-brain 知识管理系统",
  "icon" : {
    "glyph" : "brain.head.profile",
    "color" : "#7B68EE"
  },
  "clientVersion" : 685
}
